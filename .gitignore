driver/*.ko
driver/*.mod
driver/*.mod.c
driver/*.mod.o
driver/.*.cmd
driver/.*.o
driver/*.o.d
driver/.tmp_versions/
driver/Module.symvers
driver/modules.order
driver/Module.markers

