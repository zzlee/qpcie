# ==============================================================================
# QPCIe Project .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Vivado / Xilinx Tools Build Artifacts & Temporary Files
# ------------------------------------------------------------------------------
build/
tmp_proj/
tmp_ip/
.Xil/
.gen/
.srcs/
xsim.dir/
work_sim/
*.log
*.pb
*.jou
*.wdb
*.vcd
*.str
*.str.bak
vivado_*.backup.log
vivado_*.backup.jou
xsim_*.backup.log
xsim_*.backup.jou

# ------------------------------------------------------------------------------
# 2. Linux Kernel Driver Build Artifacts
# ------------------------------------------------------------------------------
driver/*.o
driver/*.ko
driver/*.mod
driver/*.mod.c
driver/*.mod.o
driver/.*.cmd
driver/.*.o
driver/*.o.d
driver/.tmp_versions/
driver/Module.symvers
driver/modules.order

# ------------------------------------------------------------------------------
# 3. User Test App Build Artifacts & Captured Media Files
# ------------------------------------------------------------------------------
test_app/*.o
test_app/qpcie_sanity_check
test_app/v4l2_test_app
test_app/alsa_test_app
test_app/dmabuf_p2p_test_app
test_app/loopback_test_app
*.yuv
*.pcm
*.raw
raw/*.pdf

# ------------------------------------------------------------------------------
# 4. OS, IDE, Editor & Temporary Files
# ------------------------------------------------------------------------------
.DS_Store
*.swp
*.swo
*~
*.bak
*.tmp
