test_app/alsa_test_app
test_app/alsa_loopback_test_app
test_app/dmabuf_p2p_test_app
test_app/loopback_test_app
*.yuv
*.pcm
*.raw
raw/*.pdf

# ------------------------------------------------------------------------------
