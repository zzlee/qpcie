sim_*
!scripts/sim_sc7f0_csr_cdc.tcl
!scripts/sim_sc7f0_hdmi_bridges.tcl
!scripts/sim_sc7f0_hdmi_control.tcl
*.vvp
*.out
*.fst

# ------------------------------------------------------------------------------
# 3. Linux Kernel Driver Build Artifacts
# ------------------------------------------------------------------------------
driver/*.o
driver/*.ko
driver/*.mod
driver/*.mod.c
driver/*.mod.o
driver/.*.cmd
driver/.*.o
driver/*.o.d
driver/.tmp_versions/
driver/Module.symvers
driver/modules.order
driver/Module.markers

# ------------------------------------------------------------------------------
# 4. User Test App Build Artifacts & Captured Media Files
# ------------------------------------------------------------------------------
test_app/*.o
test_app/qpcie_sanity_check
test_app/qpcie_upgrade
test_app/qpcie_upgrade_daemon
test_app/sc7f0ctl
test_app/qpcie_debugd
test_app/qpcie_ddr_verify
test_app/qpcie_dma_diag
test_app/qpcie_stage_push
test_app/qpcie_flash
test_app/qpcie_a50t_tool
