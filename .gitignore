# ==============================================================================
# QPCIe Project .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Vivado / Xilinx Tools Build Artifacts & Temporary Files
# ------------------------------------------------------------------------------
build/
hd_visual/
tmp_proj/
tmp_ip/
.Xil/
.gen/
.srcs/
.hw/
xsim.dir/
work_sim/
*.log
*.pb
*.jou
*.wdb
*.vcd
*.str
*.str.bak
*.prm
*.bit
*.bin
*.mcs
*.dcp
*.rpt
webtalk*
hs_err_pid*.log
vivado_*.backup.log
vivado_*.backup.jou
xsim_*.backup.log
xsim_*.backup.jou
petalinux/*/project-spec/hw-description/drivers/
petalinux/*/project-spec/hw-description/psu_init*
petalinux/*/project-spec/hw-description/*.mmi
petalinux/*/time.build
hw_platform/*.mmi
hw_platform/*.html
hw_platform/*.tcl
hw_platform/psu_init_gpl.*
scripts/archive_debug/

# ------------------------------------------------------------------------------
# 2. Simulation Artifacts (Icarus Verilog, ModelSim, Verilator)
# ------------------------------------------------------------------------------
