#!/bin/sh
# Select the connected Xilinx TX exposing the tested mode. modetest keeps the
# CRTC programmed while stdin is open; systemd terminates the whole cgroup.
set -eu
id=$(modetest -M xlnx -c | awk '$3=="connected" {id=$1} $3=="disconnected" {id=""} id && /3840x2160/ && /60\.00/ {print id; exit}')
case "$id" in ''|*[!0-9]*) echo 'No connected 3840x2160p60 TX' >&2; exit 1;; esac
sleep infinity | modetest -M xlnx -s "$id:3840x2160-60@AR24"
