+/*****************************************************************************/
+/** This function prepares PCAP interface for Tandem Stage 2 bitstream download
+ *  without asserting PROG_B to keep Stage 1 PCIe link active and running.
+ *
+ * @param	None
+ *
+ * @return	XFSBL_SUCCESS
+ *
+ *****************************************************************************/
+u32 XFsbl_PcapPrepareStage2(void) {
+	u32 RegVal;
+
+	/* Take PCAP out of Reset without asserting PROG_B */
+	RegVal = XFsbl_In32(CSU_PCAP_RESET);
+	RegVal &= (~CSU_PCAP_RESET_RESET_MASK);
+	XFsbl_Out32(CSU_PCAP_RESET, RegVal);
+
+	/* Select PCAP mode and change PCAP to write mode */
+	RegVal = CSU_PCAP_CTRL_PCAP_PR_MASK;
+	XFsbl_Out32(CSU_PCAP_CTRL, RegVal);
+	XFsbl_Out32(CSU_PCAP_RDWR, 0x0);
+
+	return XFSBL_SUCCESS;
+}
+
