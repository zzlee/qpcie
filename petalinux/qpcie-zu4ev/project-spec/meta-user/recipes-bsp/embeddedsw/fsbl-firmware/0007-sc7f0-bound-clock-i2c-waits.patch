+static u8 si5341_current_page = 0xff;
+
+static s32 si5341_wait_idle(XIicPs *Instance)
+{
+	XTime start, now;
+	XTime_GetTime(&start);
+	while (XIicPs_BusIsBusy(Instance)) {
+		XTime_GetTime(&now);
+		if (now - start >= COUNTS_PER_SECOND / 10U) {
+			XIicPs_Abort(Instance);
 			return XST_FAILURE;
 		}
-
-		while(XIicPs_BusIsBusy(IicInstance)) {
-			/* NOP */
-		}
