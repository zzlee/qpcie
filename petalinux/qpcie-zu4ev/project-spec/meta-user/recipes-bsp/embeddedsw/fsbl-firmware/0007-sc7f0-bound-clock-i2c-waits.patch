-	Status = XIicPs_MasterSendPolled(IicInstance, send_buf, 2, slave);
-	if (Status != XST_SUCCESS) {
-		XFsbl_Printf(DEBUG_GENERAL, "XFSBL_ERROR_I2C_WRITE\r\n");
+	}
+	return XST_SUCCESS;
+}
+
+static s32 si5341_send(XIicPs *Instance, u8 *Data)
+{
+	if (si5341_wait_idle(Instance) != XST_SUCCESS ||
+	    XIicPs_MasterSendPolled(Instance, Data, 2, IIC_ADDR_SI5341) != XST_SUCCESS)
 		return XST_FAILURE;
-	}
-
-	while(XIicPs_BusIsBusy(IicInstance)) {
-		/* NOP */
-	}
-
-	return Status;
+	return si5341_wait_idle(Instance);
+}
+
+static s32 si5341_write(XIicPs *Instance, u16 Address, u8 Data)
+{
+	u8 buf[2] = {0x01, Address >> 8};
+	if (buf[1] != si5341_current_page) {
+		if (si5341_send(Instance, buf) != XST_SUCCESS)
+			return XST_FAILURE;
+		si5341_current_page = buf[1];
+	}
+	buf[0] = Address & 0xff;
+	buf[1] = Data;
+	return si5341_send(Instance, buf);
 }
 
